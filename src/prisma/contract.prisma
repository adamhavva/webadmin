// use prisma-8


// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  CUSTOMER
  BARISTA
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InventoryItemType {
  SEMI_FINISHED
  DIRECT_USE
}

enum InventoryUnit {
  ML
  PCS
}

enum InventoryBatchSourceType {
  RESTOCK
  PRODUCTION
}


// ============================================================
// USER
// ============================================================

model User {

  id           Int                        @id @default(autoincrement())

  firebaseUid  String                     @unique
  email        String?
  role         UserRole
  status       UserStatus                 @default(ACTIVE)

  name         String
  phone        String?

  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

}


// ============================================================
// PRODUCT
// ============================================================

model Product {

  id              Int                        @id @default(autoincrement())

  name            String
  sellingPrice    Decimal

  recipes         ProductRecipe[]
  costHistories   ProductCostHistory[]

  isActive        Boolean                    @default(true)

  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()

}


// ============================================================
// PRODUCT RECIPE
// ============================================================

model ProductRecipe {

  id          Int               @id @default(autoincrement())

  product     Product           @relation(fields:[productId], references:[id])
  productId   Int

  version     Int
  isActive    Boolean           @default(true)

  items       RecipeItem[]

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([productId, version])

}


// ============================================================
// RECIPE ITEM
// ============================================================

model RecipeItem {

  id              Int           @id @default(autoincrement())

  recipe          ProductRecipe @relation(fields:[recipeId], references:[id])
  recipeId        Int

  inventoryItem   InventoryItem @relation(fields:[inventoryItemId], references:[id])
  inventoryItemId Int

  quantity        Decimal

}


// ============================================================
// INVENTORY ITEM
// ============================================================

model InventoryItem {

  id          Int                        @id @default(autoincrement())

  name        String

  type        InventoryItemType

  unit        InventoryUnit

  isActive    Boolean                    @default(true)

  batches     InventoryBatch[]

  recipeItems RecipeItem[]

  restocks    Restock[]

  productions Production[]

  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

}


// ============================================================
// INVENTORY BATCH
// ============================================================

model InventoryBatch {

  id              Int                        @id @default(autoincrement())

  inventoryItem   InventoryItem              @relation(fields:[inventoryItemId], references:[id])
  inventoryItemId Int

  batchCode       String                     @unique

  sourceType      InventoryBatchSourceType

  quantity        Decimal

  remainingQuantity Decimal

  unitCost        Decimal

  totalCost       Decimal

  stock           InventoryBatchStock?

  production      Production?

  restock         Restock?

  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([inventoryItemId])
  @@index([inventoryItemId, createdAt])

}


// ============================================================
// INVENTORY BATCH STOCK
// ============================================================

model InventoryBatchStock {

  id               Int                        @id @default(autoincrement())

  batch            InventoryBatch             @relation(fields:[batchId], references:[id])
  batchId          Int                        @unique

  quantity         Decimal

  remainingQuantity Decimal

  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

}


// ============================================================
// RESTOCK
// ============================================================

model Restock {

  id              Int               @id @default(autoincrement())

  inventoryItem   InventoryItem     @relation(fields:[inventoryItemId], references:[id])
  inventoryItemId Int

  batch           InventoryBatch    @relation(fields:[batchId], references:[id])
  batchId         Int               @unique

  quantity        Decimal

  totalCost       Decimal

  unitCost        Decimal

  supplierName    String?

  createdAt       TimestamptzString @default(now())

}


// ============================================================
// PRODUCTION
// ============================================================

model Production {

  id              Int               @id @default(autoincrement())

  inventoryItem   InventoryItem     @relation(fields:[inventoryItemId], references:[id])
  inventoryItemId Int

  batch           InventoryBatch    @relation(fields:[batchId], references:[id])
  batchId         Int               @unique

  outputQuantity  Decimal

  totalCost       Decimal

  unitCost        Decimal

  components      ProductionComponent[]

  createdAt       TimestamptzString @default(now())

}


// ============================================================
// PRODUCTION COMPONENT
// ============================================================

model ProductionComponent {

  id              Int               @id @default(autoincrement())

  production      Production        @relation(fields:[productionId], references:[id])
  productionId    Int

  inventoryItem   InventoryItem?    @relation(fields:[inventoryItemId], references:[id])
  inventoryItemId Int?

  name            String

  quantity        Decimal

  unit            InventoryUnit

  unitCost        Decimal

  totalCost       Decimal

  createdAt       TimestamptzString @default(now())

}


// ============================================================
// PRODUCT COST HISTORY
// ============================================================

model ProductCostHistory {

  id          Int               @id @default(autoincrement())

  product     Product           @relation(fields:[productId], references:[id])
  productId   Int

  hpp         Decimal

  createdAt   TimestamptzString @default(now())

}