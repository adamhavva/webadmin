// ============================================================
// ASCEND PRISMA SCHEMA
// Product + Inventory + Recipe + Production + HPP
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  // url dari prisma7.config.ts atau env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  CUSTOMER
  BARISTA
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InventoryUnit {
  ML
  PCS
}

// InventoryBatch hanya untuk stock MATERIAL.
// Product jadi TIDAK masuk ke sini.
// Product jadi ada di FinishedProductBatch.
enum InventoryBatchSourceType {
  RESTOCK
}

// ============================================================
// USER
// ============================================================

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique

  role   UserRole
  status UserStatus @default(ACTIVE)

  name      String
  phone     String?
  address   String?
  avatarUrl String?  @db.Text

  // Metadata karyawan — relevan untuk BARISTA & CUSTOMER.
  // Semua optional.
  idNumber   String?   // No KTP
  birthDate  DateTime? // Tanggal lahir
  joinDate   DateTime? // Tanggal masuk kerja
  addressKtp String?   // Alamat sesuai KTP

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id String @id @default(cuid())

  name         String
  sellingPrice Decimal

  isActive Boolean @default(true)

  recipes       ProductRecipe[]
  productions   Production[]
  costHistories ProductCostHistory[]

  finishedProductBatches FinishedProductBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
}

// ============================================================
// PRODUCT RECIPE
// ============================================================

model ProductRecipe {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  version Int

  isActive Boolean @default(true)

  items RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, version])
  @@index([productId])
  @@index([productId, isActive])
}

// ============================================================
// RECIPE ITEM
// ============================================================

model RecipeItem {
  id String @id @default(cuid())

  recipe   ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryItemId String

  quantity Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, inventoryItemId])
  @@index([recipeId])
  @@index([inventoryItemId])
}

// ============================================================
// INVENTORY ITEM
// ============================================================

model InventoryItem {
  id String @id @default(cuid())

  name String
  unit InventoryUnit

  isActive Boolean @default(true)

  batches InventoryBatch[]

  recipeItems RecipeItem[]

  restocks Restock[]

  productionComponents ProductionComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
}

// ============================================================
// INVENTORY BATCH
// ============================================================

model InventoryBatch {
  id String @id @default(cuid())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryItemId String

  batchCode String @unique

  sourceType InventoryBatchSourceType

  quantity          Decimal
  remainingQuantity Decimal

  unitCost  Decimal
  totalCost Decimal

  restock Restock?

  productionComponents ProductionComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inventoryItemId])
  @@index([inventoryItemId, createdAt])
  @@index([inventoryItemId, remainingQuantity])
  @@index([sourceType])
}

// ============================================================
// RESTOCK
// ============================================================

model Restock {
  id String @id @default(cuid())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryItemId String

  batch   InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId String         @unique

  quantity  Decimal
  totalCost Decimal
  unitCost  Decimal

  supplierName String?

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([createdAt])
}

// ============================================================
// PRODUCTION
// ============================================================

model Production {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String

  outputQuantity Decimal

  totalCost Decimal
  unitCost  Decimal

  components ProductionComponent[]

  finishedProductBatch FinishedProductBatch?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ============================================================
// PRODUCTION COMPONENT
// ============================================================

model ProductionComponent {
  id String @id @default(cuid())

  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  productionId String

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryItemId String

  inventoryBatch   InventoryBatch @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)
  inventoryBatchId String

  name String

  quantity Decimal

  unit InventoryUnit

  unitCost Decimal

  totalCost Decimal

  createdAt DateTime @default(now())

  @@index([productionId])
  @@index([inventoryItemId])
  @@index([inventoryBatchId])
  @@index([productionId, inventoryItemId])
}

// ============================================================
// FINISHED PRODUCT BATCH
// ============================================================

model FinishedProductBatch {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String

  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  productionId String     @unique

  batchCode String @unique

  quantity          Decimal
  remainingQuantity Decimal

  unitCost Decimal

  totalCost Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productId, remainingQuantity])
  @@index([createdAt])
}

// ============================================================
// PRODUCT COST HISTORY
// ============================================================

model ProductCostHistory {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  hpp Decimal

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([productId, createdAt])
}