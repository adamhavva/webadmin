// ============================================================
// ASCEND PRISMA SCHEMA
// Product + Inventory + Recipe + Production + HPP
// + Pusat + Barista Mobile + Orders
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  // url dari prisma7.config.ts atau env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

// ============================================================
// ENUMS (Legacy - kept for backward compatibility)
// These enums are deprecated and will be removed in future migrations.
// All payment-related enums are now stored as strings in the database.
// ============================================================

// @deprecated Use String "PENDING" | "PAID" | "FAILED" | "EXPIRED" | "REFUNDED"
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

// @deprecated Use String "MIDTRANS" | "INTERNAL"
// enum PaymentProvider removed - use String instead
// enum PaymentProvider {
//   DOKU  // renamed to MIDTRANS
//   INTERNAL
// }

// @deprecated Use String "NONE" | "PERCENTAGE" | "NOMINAL"
enum UserRole {
  ADMIN
  CUSTOMER
  BARISTA
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InventoryUnit {
  ML
  PCS
  GR
}

// InventoryBatch hanya untuk stock MATERIAL.
// Product jadi TIDAK masuk ke sini.
// Product jadi ada di FinishedProductBatch.
enum InventoryBatchSourceType {
  RESTOCK
}

enum RestockStatus {
  ACTIVE
  VOIDED
}

// ---------- ORDER ----------

enum OrderStatus {
  PENDING // order dibuat, belum ada barista
  SEARCHING // sistem cari barista
  ASSIGNED // barista ditunjuk, belum accept
  ACCEPTED // barista accept
  DELIVERING // barista jalan ke customer
  ARRIVED // barista sampai
  COMPLETED // selesai
  CANCELLED // dibatalkan
  FAILED // gagal antar
}

enum ReassignReason {
  STOK_HABIS
  ALAT_RUSAK
  JARAK_TERLALU_JAUH
  LAINNYA
}

// ---------- BARISTA STOCK ----------

enum BaristaStockMovementType {
  RESTOCK // ambil dari pusat
  SOLD // terjual (online atau offline)
  ADJUSTMENT // koreksi manual
  RETURN // balik ke pusat
  WASTE // rusak/basi
}

// ============================================================
// SETTING — key-value untuk config global
// ============================================================

enum SettingType {
  PERCENTAGE // nilai dalam % (contoh: 12 untuk 12%)
  NOMINAL // nilai dalam rupiah (contoh: 2000 untuk Rp 2.000)
}

model Setting {
  id String @id @default(cuid())

  key         String  @unique // "tax", "fee_barista", "fee_midtrans"
  name        String // "Pajak", "Biaya Barista"
  description String? @db.Text

  type  SettingType
  value Decimal // bisa 12 (persen) atau 2000 (nominal)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

// ============================================================
// PUSAT — 1 lokasi dapur + gudang
// ============================================================

model Pusat {
  id String @id @default(cuid())

  name      String
  address   String  @db.Text
  latitude  Float
  longitude Float
  phone     String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ============================================================
// USER
// ============================================================

model User {
  id          String @id @default(cuid())
  firebaseUid String @unique

  role   UserRole
  status UserStatus @default(ACTIVE)

  name      String
  phone     String?
  address   String?
  avatarUrl String? @db.Text
  latitude  Float?
  longitude Float?

  // Metadata karyawan — relevan untuk BARISTA & CUSTOMER.
  // Semua optional.
  idNumber   String? // No KTP
  birthDate  DateTime? // Tanggal lahir
  joinDate   DateTime? // Tanggal masuk kerja
  addressKtp String? // Alamat sesuai KTP

  // ---------- Relasi Order ----------
  ordersAsCustomer Order[] @relation("CustomerOrders")
  ordersAsBarista  Order[] @relation("BaristaOrders")

  // ---------- Relasi Barista Stock ----------
  baristaStocks   BaristaStock[]
  baristaRestocks BaristaRestock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id String @id @default(cuid())

  name         String
  sellingPrice Decimal @default(0)
  description  String? @db.Text

  isActive Boolean @default(true)

  recipes                ProductRecipe[]
  productions            Production[]
  costHistories          ProductCostHistory[]
  finishedProductBatches FinishedProductBatch[]

  images   ProductImage[]
  metadata ProductMetadata[]

  // ---------- Relasi Barista + Order ----------
  orderItems          OrderItem[]
  baristaStocks       BaristaStock[]
  baristaRestockItems BaristaRestockItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
}

// ============================================================
// PRODUCT IMAGE
// ============================================================

model ProductImage {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  key String @unique

  url String

  fileName String
  fileSize Int
  mimeType String

  isPrimary Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productId, isPrimary])
  @@index([productId, sortOrder])
}

// ============================================================
// PRODUCT METADATA
// ============================================================

model ProductMetadata {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  key   String
  value String @db.Text

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, key])
  @@index([productId])
  @@index([productId, sortOrder])
}

// ============================================================
// PRODUCT RECIPE
// ============================================================

model ProductRecipe {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  version Int

  isActive Boolean @default(true)

  items RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, version])
  @@index([productId])
  @@index([productId, isActive])
}

// ============================================================
// RECIPE ITEM
// ============================================================

model RecipeItem {
  id String @id @default(cuid())

  recipe   ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryItemId String

  quantity Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, inventoryItemId])
  @@index([recipeId])
  @@index([inventoryItemId])
}

// ============================================================
// INVENTORY ITEM
// ============================================================

model InventoryItem {
  id String @id @default(cuid())

  name String
  unit InventoryUnit

  isActive Boolean @default(true)

  batches InventoryBatch[]

  recipeItems RecipeItem[]

  restocks Restock[]

  productionComponents ProductionComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
}

// ============================================================
// INVENTORY BATCH
// ============================================================

model InventoryBatch {
  id String @id @default(cuid())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryItemId String

  batchCode String @unique

  sourceType InventoryBatchSourceType

  quantity          Decimal
  remainingQuantity Decimal

  unitCost  Decimal
  totalCost Decimal

  restock Restock?

  productionComponents ProductionComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inventoryItemId])
  @@index([inventoryItemId, createdAt])
  @@index([inventoryItemId, remainingQuantity])
  @@index([sourceType])
}

// ============================================================
// RESTOCK
// ============================================================

model Restock {
  id String @id @default(cuid())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryItemId String

  batch   InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId String         @unique

  quantity  Decimal
  totalCost Decimal
  unitCost  Decimal

  supplierName String?

  status   RestockStatus @default(ACTIVE)
  voidedAt DateTime?
  voidNote String?

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([createdAt])
  @@index([status])
  @@index([voidedAt])
}

// ============================================================
// PRODUCTION
// ============================================================

model Production {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String

  outputQuantity Decimal

  totalCost Decimal
  unitCost  Decimal

  components ProductionComponent[]

  finishedProductBatch FinishedProductBatch?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ============================================================
// PRODUCTION COMPONENT
// ============================================================

model ProductionComponent {
  id String @id @default(cuid())

  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  productionId String

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryItemId String

  inventoryBatch   InventoryBatch @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)
  inventoryBatchId String

  name String

  quantity Decimal

  unit InventoryUnit

  unitCost Decimal

  totalCost Decimal

  createdAt DateTime @default(now())

  @@index([productionId])
  @@index([inventoryItemId])
  @@index([inventoryBatchId])
  @@index([productionId, inventoryItemId])
}

// ============================================================
// FINISHED PRODUCT BATCH
// ============================================================

model FinishedProductBatch {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String

  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  productionId String     @unique

  batchCode String @unique

  quantity          Decimal
  remainingQuantity Decimal

  unitCost Decimal

  totalCost Decimal

  // ---------- Relasi Barista + Order ----------
  orderItems          OrderItem[]
  baristaRestockItems BaristaRestockItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productId, remainingQuantity])
  @@index([createdAt])
}

// ============================================================
// PRODUCT COST HISTORY
// ============================================================

model ProductCostHistory {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  hpp Decimal

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([productId, createdAt])
}

// ============================================================
// BARISTA STOCK — stok produk jadi yang dibawa barista
// ============================================================

model BaristaStock {
  id String @id @default(cuid())

  baristaId String
  barista   User   @relation(fields: [baristaId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity      Int       @default(0) // stok saat ini di gerobak
  minThreshold  Int       @default(3) // batas notif "perlu restock"
  lastRestockAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([baristaId, productId])
  @@index([baristaId])
  @@index([productId])
  @@index([baristaId, quantity])
}

// ============================================================
// BARISTA RESTOCK — ambil stok dari pusat
// ============================================================

model BaristaRestock {
  id String @id @default(cuid())

  baristaId String
  barista   User   @relation(fields: [baristaId], references: [id], onDelete: Restrict)

  items BaristaRestockItem[]

  totalItems Int     @default(0)
  note       String? @db.Text

  createdAt DateTime @default(now())

  @@index([baristaId])
  @@index([createdAt])
}

model BaristaRestockItem {
  id String @id @default(cuid())

  restockId String
  restock   BaristaRestock @relation(fields: [restockId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Batch yang diambil (traceability FIFO)
  finishedBatchId String?
  finishedBatch   FinishedProductBatch? @relation(fields: [finishedBatchId], references: [id], onDelete: SetNull)

  quantity Int
  unitCost Decimal

  createdAt DateTime @default(now())

  @@index([restockId])
  @@index([productId])
}

// ============================================================
// BARISTA STOCK MOVEMENT — audit log
// ============================================================

model BaristaStockMovement {
  id String @id @default(cuid())

  baristaId String
  productId String

  type         BaristaStockMovementType
  quantity     Int // signed: + masuk, - keluar
  balanceAfter Int // saldo setelah movement

  // Referensi (opsional)
  orderId          String?
  baristaRestockId String?

  note String? @db.Text

  createdAt DateTime @default(now())

  @@index([baristaId, createdAt])
  @@index([productId, createdAt])
  @@index([type])
}

// ============================================================
// ORDER — online + offline
// ============================================================
//
// Payment flow: Order created with status=PENDING, channel=ONLINE/OFFLINE
//   paymentChannel = "PREPAID" (always SNAP)
//   paymentMethodCode/paymentMethodName = snapshot from Midtrans webhook
//   After payment: status → SEARCHING, paymentStatus → PAID
//
model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // "ORD-20260924-0001"

  // Business channel: ONLINE (customer app) or OFFLINE (barista POS)
  // NOT a payment channel — see paymentChannel for Midtrans payment type
  channel String?

  charges OrderCharge[]

  // ---------- Customer ----------
  customerId String?
  customer   User?   @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)

  // Snapshot customer
  customerName  String
  customerPhone String?

  // Alamat pengiriman (nullable untuk offline)
  deliveryAddress   String? @db.Text
  deliveryLatitude  Float?
  deliveryLongitude Float?
  deliveryNote      String? @db.Text

  // ---------- Barista ----------
  baristaId String?
  barista   User?   @relation("BaristaOrders", fields: [baristaId], references: [id], onDelete: SetNull)

  status OrderStatus @default(PENDING)

  // ---------- Reassign ----------
  originalBaristaId String?
  reassignedAt      DateTime?
  reassignReason    ReassignReason?
  reassignNote      String?         @db.Text
  reassignCount     Int             @default(0)

  // ---------- Timing ----------
  assignedAt   DateTime?
  acceptedAt   DateTime?
  deliveringAt DateTime?
  arrivedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // ---------- ETA & tracking ----------
  estimatedDeliveryAt DateTime?
  actualDeliveryAt    DateTime?
  distanceKm          Float?

  // ---------- Harga ----------
  subtotal     Decimal // total item sebelum biaya
  chargesTotal Decimal @default(0) // ← total semua biaya tambahan
  deliveryFee  Decimal @default(0) // free (0)
  total        Decimal // subtotal + chargesTotal + deliveryFee

  // ---------- Items & history ----------
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  // ---------- PAYMENT ----------
  paymentStatus   PaymentStatus @default(PENDING)
  paymentProvider String        @default("MIDTRANS") // "MIDTRANS" | "INTERNAL"

  // Payment channel — always "PREPAID" for Midtrans Snap
  paymentChannel String?

  // Snapshot of Midtrans payment_type (qris, bank_transfer, gopay, shopeepay, etc.)
  paymentMethodCode  String?
  // Snapshot of Midtrans payment_name
  paymentMethodName  String?
  // Snapshot of Midtrans display_group (optional)
  paymentMethodGroup String?

  // Fee snapshot
  paymentFeeAmount Decimal @default(0)

  // Provider-specific (Midtrans)
  snapToken        String?   @unique
  paymentUrl       String?   @db.Text
  // Same as payment_type from Midtrans notification (qris, bank_transfer, etc.)
  providerChannel  String?
  paymentExpiredAt DateTime?
  callbackPayload  Json?

  paidAt DateTime?

  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([paymentStatus]) // kalau ada report payment
  @@index([paymentMethodCode]) // kalau ada report channel
  // Composite — untuk query utama
  @@index([baristaId, status]) // barista lihat order mereka
  @@index([customerId, status]) // customer lihat order mereka
  @@index([status, createdAt]) // admin dashboard (recent by status)
  @@index([baristaId, createdAt]) // riwayat barista
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Snapshot
  productName String
  quantity    Int
  unitPrice   Decimal
  subtotal    Decimal
  notes       String? @db.Text

  // Batch yang dipakai (opsional traceability)
  finishedBatchId String?
  finishedBatch   FinishedProductBatch? @relation(fields: [finishedBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    OrderStatus
  note      String?     @db.Text
  actorId   String?
  actorRole UserRole?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([status])
}

model OrderCharge {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Snapshot setting saat order dibuat
  settingKey  String // "tax", "fee_barista", "fee_midtrans"
  settingName String // "Pajak", "Biaya Barista" (snapshot)
  type        SettingType // PERCENTAGE / NOMINAL (snapshot)
  rateValue   Decimal // 12 (persen) atau 2000 (nominal)

  // Hasil kalkulasi
  amount Decimal // nilai aktual (mis. Rp 3.000)

  sortOrder Int @default(0) // urutan tampil di struk

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([settingKey])
  @@index([createdAt])
}

// ============================================================
// PAYMENT WEBHOOK LOG - Webhook audit trail
// ============================================================

model PaymentWebhookLog {
  id String @id @default(cuid())

  // Request info
  requestId      String? // X-EXTERNAL-ID
  requestPath    String
  requestMethod  String  @default("POST")
  requestHeaders Json?
  requestBody    Json?

  // Response info
  responseStatus Int?
  responseBody   Json?

  // Processing result
  isProcessed     Boolean   @default(false)
  processedAt     DateTime?
  processingError String?   @db.Text

  // Linked payment (if determinable)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([isProcessed])
  @@index([paymentId])
  @@index([createdAt])
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount   Decimal
  currency String  @default("IDR")

  // Midtrans payment method snapshot
  methodCode      String? // Midtrans payment_type: qris, bank_transfer, gopay, shopeepay, etc.
  methodName      String? // Midtrans payment_name
  methodGroup     String? // Midtrans display_group: VA, EWALLET, QRIS
  providerChannel String? // Same as payment_type from Midtrans notification
  methodFeeAmount Decimal @default(0)

  // Status - stored as String
  status String @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "EXPIRED" | "REFUNDED"

  // Midtrans transaction info
  snapToken             String? @unique // Midtrans snap token
  providerTransactionId String? // Midtrans transaction_id
  paymentUrl            String? @db.Text // Midtrans redirect_url

  // Payload logging
  requestPayload  Json?
  callbackPayload Json?

  // Timestamps
  paidAt        DateTime?
  expiredAt     DateTime?
  failedAt      DateTime?
  failureReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  webhookLogs PaymentWebhookLog[]

  @@index([status])
  @@index([methodCode])
}
